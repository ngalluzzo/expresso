{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"emitDeclarationOnly": false
	},
	"include": ["src"],
	"exclude": [
		"dist",
		"node_modules",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"src/**/test/**"
	]
}
